{
    "name": "prasadchinwal/box",
    "description": "A wrapper for integrating with BOX APIs.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "prasadchinwal",
            "email": "prasadchinwal5@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "guzzlehttp/guzzle": "^7.7",
        "illuminate/filesystem": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "league/flysystem": "^3.25.1",
        "firebase/php-jwt": "^7.0",
        "spatie/laravel-data": "^3.12|^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "PrasadChinwal\\Box\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrasadChinwal\\Box\\Test\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PrasadChinwal\\Box\\BoxServiceProvider"
            ],
            "aliases": {
                "Box": "PrasadChinwal\\Box\\Facades\\Box"
            }
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {}
    }
}
